<Window x:Class="NeedleDrop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Needle Drop — Spotify Song-Guessing Game"
        Height="860" Width="540"
        MinHeight="700" MinWidth="460"
        WindowStartupLocation="CenterScreen"
        Background="#241C15"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- ===== Palette ===== -->
        <SolidColorBrush x:Key="BgBrush" Color="#241C15"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#2B2118"/>
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#3A2C1E"/>
        <SolidColorBrush x:Key="LineBrush" Color="#4E3B27"/>
        <SolidColorBrush x:Key="TextBrush" Color="#EDE1C8"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A08D6E"/>
        <SolidColorBrush x:Key="GoldBrush" Color="#C08A2E"/>
        <SolidColorBrush x:Key="GoldDimBrush" Color="#7A5720"/>
        <SolidColorBrush x:Key="MustardBrush" Color="#B0602A"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#6B8E52"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#A8432E"/>
        <SolidColorBrush x:Key="OnAccentBrush" Color="#221A10"/>

        <!-- ===== Primary gold button ===== -->
        <Style x:Key="GoldButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource GoldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource MustardBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Secondary outline button ===== -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource GoldButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Link-style button ===== -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" TextDecorations="Underline"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Radio-style option chip (ToggleButton) ===== -->
        <Style x:Key="RadioChip" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                                <Setter TargetName="border" Property="Background" Value="#1AC08A2E"/>
                                <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Big mode-select card ===== -->
        <Style x:Key="ModeCard" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Battle card (Streams Showdown) ===== -->
        <Style x:Key="BattleCard" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource GoldDimBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Toggle row check box ===== -->
        <Style x:Key="ToggleRowCheck" TargetType="Border">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{StaticResource MutedBrush}"/>
        </Style>

        <!-- ===== Text input ===== -->
        <Style x:Key="TextInput" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{StaticResource GoldBrush}"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="ComboInput" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="EyebrowText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="WizardCopy" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>

        <Style x:Key="StepDot" TargetType="Border">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="4"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Background" Value="{StaticResource LineBrush}"/>
            <Setter Property="Margin" Value="3,0"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="ChoiceButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource GoldDimBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LeaderboardRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="ONE SECOND. ONE GUESS. ONE STREAK." Style="{StaticResource EyebrowText}"/>
            <TextBlock FontFamily="Georgia" FontWeight="Black" FontSize="42" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4">
                <Run Text="NEEDLE "/><Run Text="DROP" FontStyle="Italic" FontWeight="Medium" Foreground="{StaticResource GoldBrush}"/>
            </TextBlock>
            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap">
                Two ways to play: name the track from one second of audio, or call which of two songs has more streams.
            </TextBlock>
        </StackPanel>

        <!-- Card -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="26">
            <Grid>

                <!-- ============ SCREEN 0: MODE SELECT ============ -->
                <StackPanel x:Name="ScreenModeSelect" Visibility="Visible">
                    <TextBlock Text="CHOOSE YOUR GAME" Style="{StaticResource EyebrowText}"/>
                    <TextBlock Text="Pick a mode" FontFamily="Georgia" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,18"/>

                    <Button Style="{StaticResource ModeCard}" Click="ChooseSongMode_Click">
                        <StackPanel>
                            <TextBlock Text="🎵  Guess the Song" FontWeight="Bold" FontSize="16" Foreground="{StaticResource GoldBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="Hear one second of a track from your Liked Songs, a playlist, or the Daily Drop. Name it by song, artist, or multiple choice." Foreground="{StaticResource MutedBrush}" FontSize="12.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ModeCard}" Click="ChooseStreamsMode_Click">
                        <StackPanel>
                            <TextBlock Text="📈  Streams Showdown" FontWeight="Bold" FontSize="16" Foreground="{StaticResource GoldBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="Two tracks step up. Pick the one with more streams. Keep your streak alive as long as you can — pull tracks from a playlist or straight from Billboard's yearly charts." Foreground="{StaticResource MutedBrush}" FontSize="12.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- ============ SCREEN 1: SETUP (song mode) ============ -->
                <StackPanel x:Name="ScreenSetup" Visibility="Collapsed">

                    <Border x:Name="SetupErrorBox" Background="#1EA8432E" BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,16" Visibility="Collapsed">
                        <TextBlock x:Name="SetupErrorText" Foreground="#E8A488" FontSize="13" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Step indicator -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,22">
                        <Border x:Name="Dot1" Style="{StaticResource StepDot}" Background="{StaticResource GoldBrush}"/>
                        <Border x:Name="Dot2" Style="{StaticResource StepDot}"/>
                        <Border x:Name="Dot3" Style="{StaticResource StepDot}"/>
                        <Border x:Name="Dot4" Style="{StaticResource StepDot}"/>
                    </StackPanel>

                    <!-- Step 1 -->
                    <StackPanel x:Name="WizardStep1">
                        <TextBlock Text="STEP 1 OF 4" Style="{StaticResource EyebrowText}"/>
                        <TextBlock Text="Before the first spin" FontFamily="Georgia" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                        <TextBlock Style="{StaticResource WizardCopy}" Text="Spotify requires each player to register a small app of their own. It's what keeps tools like this one running. Two minutes, once, on this device."/>
                        <Button Content="Show me how →" Style="{StaticResource GoldButton}" Click="WizardNext1_Click"/>
                        <Button Content="Already got a Client ID? Jump to the end" Style="{StaticResource LinkButton}" Click="SkipToPaste_Click"/>
                        <Button Content="← All games" Style="{StaticResource LinkButton}" Click="BackToModeSelect_Click"/>
                    </StackPanel>

                    <!-- Step 2 -->
                    <StackPanel x:Name="WizardStep2" Visibility="Collapsed">
                        <TextBlock Text="STEP 2 OF 4" Style="{StaticResource EyebrowText}"/>
                        <TextBlock Text="Make yourself an app" FontFamily="Georgia" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                        <TextBlock Style="{StaticResource WizardCopy}" Text="Head to Spotify's Developer Dashboard, sign in like you normally would, and hit Create app. Call it whatever you want. Nobody but you will ever see it."/>
                        <Button Content="Open the Dashboard ↗" Style="{StaticResource GoldButton}" Click="OpenDashboard_Click"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Back" Style="{StaticResource SecondaryButton}" Click="WizardBack2_Click"/>
                            <Button Grid.Column="2" Content="Done, made one →" Style="{StaticResource GoldButton}" Click="WizardNext2_Click"/>
                        </Grid>
                    </StackPanel>

                    <!-- Step 3 -->
                    <StackPanel x:Name="WizardStep3" Visibility="Collapsed">
                        <TextBlock Text="STEP 3 OF 4" Style="{StaticResource EyebrowText}"/>
                        <TextBlock Text="One address to add" FontFamily="Georgia" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                        <TextBlock Style="{StaticResource WizardCopy}" Text="Pop into that app's Settings and add this as a Redirect URI, then hit Save:"/>
                        <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="http://127.0.0.1:8080/callback" FontFamily="Consolas" FontSize="12.5" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" x:Name="CopyRedirectBtn" Content="Copy" Style="{StaticResource GoldButton}" Padding="10,6" Margin="10,0,0,0" Click="CopyRedirect_Click"/>
                            </Grid>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Back" Style="{StaticResource SecondaryButton}" Click="WizardBack3_Click"/>
                            <Button Grid.Column="2" Content="Saved it →" Style="{StaticResource GoldButton}" Click="WizardNext3_Click"/>
                        </Grid>
                    </StackPanel>

                    <!-- Step 4 -->
                    <StackPanel x:Name="WizardStep4" Visibility="Collapsed">
                        <TextBlock Text="STEP 4 OF 4" Style="{StaticResource EyebrowText}"/>
                        <TextBlock Text="Last thing: your Client ID" FontFamily="Georgia" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                        <TextBlock Style="{StaticResource WizardCopy}" Text="Back on your app's page, grab the Client ID sitting near the top and drop it in here:"/>
                        <TextBox x:Name="ClientIdInput" Style="{StaticResource TextInput}" Tag="e.g. 8f3a9c1b2d4e..."/>
                        <Button Content="Connect to Spotify" Style="{StaticResource GoldButton}" Click="Connect_Click"/>
                        <Button Content="← Back" Style="{StaticResource LinkButton}" Click="WizardBack4_Click"/>
                    </StackPanel>

                </StackPanel>

                <!-- ============ SCREEN 2: SOURCE (song mode) ============ -->
                <StackPanel x:Name="ScreenSource" Visibility="Collapsed">

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" FontSize="13">
                            Signed in as <Run Text="guest_user" FontFamily="Consolas" Foreground="{StaticResource GoldBrush}"/>
                        </TextBlock>
                        <Button Grid.Column="1" Content="Log out" Style="{StaticResource LinkButton}" Margin="0" Click="Logout_Click"/>
                    </Grid>

                    <TextBlock Text="SOUND SOURCE" Style="{StaticResource SectionLabel}"/>
                    <UniformGrid Columns="3" Margin="0,0,0,14">
                        <ToggleButton x:Name="OptLiked" Content="Liked Songs" Style="{StaticResource RadioChip}" IsChecked="True" Margin="0,0,4,0" Click="SourceOption_Click"/>
                        <ToggleButton x:Name="OptPlaylist" Content="A Playlist" Style="{StaticResource RadioChip}" Margin="4,0" Click="SourceOption_Click"/>
                        <ToggleButton x:Name="OptDaily" Content="Daily Drop" Style="{StaticResource RadioChip}" Margin="4,0,0,0" Click="SourceOption_Click"/>
                    </UniformGrid>

                    <StackPanel x:Name="PlaylistInputWrap" Visibility="Collapsed">
                        <TextBlock Text="PLAYLIST URL OR ID" Style="{StaticResource SectionLabel}"/>
                        <TextBox x:Name="PlaylistUrlInput" Style="{StaticResource TextInput}" Tag="https://open.spotify.com/playlist/..."/>
                    </StackPanel>

                    <TextBlock x:Name="DailyHint" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,-8,0,14" Visibility="Collapsed"
                               Text="Same 5 songs for everyone, today only. No playlist needed."/>

                    <TextBlock Text="HOW DO YOU WANT TO GUESS?" Style="{StaticResource SectionLabel}"/>
                    <UniformGrid Columns="3" Margin="0,0,0,14">
                        <ToggleButton x:Name="ModeMultiple" Content="Multiple Choice" Style="{StaticResource RadioChip}" IsChecked="True" Margin="0,0,4,0" Click="ModeOption_Click"/>
                        <ToggleButton x:Name="ModeSong" Content="By Song" Style="{StaticResource RadioChip}" Margin="4,0" Click="ModeOption_Click"/>
                        <ToggleButton x:Name="ModeArtist" Content="By Artist" Style="{StaticResource RadioChip}" Margin="4,0,0,0" Click="ModeOption_Click"/>
                    </UniformGrid>

                    <ToggleButton x:Name="RandomStartToggle" Cursor="Hand" Background="Transparent" BorderThickness="0">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="CheckBox" Style="{StaticResource ToggleRowCheck}" Grid.Column="0"/>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Random Start" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="Pulls the one second from anywhere in the track, intro or not." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="CheckBox" Property="Background" Value="{StaticResource GoldBrush}"/>
                                        <Setter TargetName="CheckBox" Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <Button Content="Pull the tracklist &amp; play" Style="{StaticResource GoldButton}" Margin="0,8,0,0" Click="LoadTracklist_Click"/>
                </StackPanel>

                <!-- ============ SCREEN 3: GAME (song mode) ============ -->
                <StackPanel x:Name="ScreenGame" Visibility="Collapsed">

                    <TextBlock x:Name="DailyBadge" Text="DAILY DROP" HorizontalAlignment="Center" Foreground="{StaticResource GoldBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,0,10" Visibility="Collapsed"/>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RoundCount" Grid.Column="0" Text="Round 1 / 10" FontFamily="Consolas" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                        <TextBlock x:Name="ScoreText" Grid.Column="1" Text="0" FontFamily="Consolas" Foreground="{StaticResource GoldBrush}" FontWeight="Bold" FontSize="18"/>
                    </Grid>

                    <!-- Turntable -->
                    <Grid Width="220" Height="220" Margin="0,8,0,20" HorizontalAlignment="Center">
                        <Ellipse Width="220" Height="220" Fill="#100b07">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#050302" BlurRadius="34" ShadowDepth="6" Opacity="0.6"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse x:Name="RecordDisc" Width="220" Height="220" Fill="#100b07" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="RecordRotation" Angle="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Width="76" Height="76" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#B0602A" Offset="0"/>
                                    <GradientStop Color="#7A5720" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="NEEDLE&#x0a;DROP" FontFamily="Georgia" FontWeight="Bold" FontSize="10" TextAlignment="Center" Foreground="{StaticResource OnAccentBrush}"/>

                        <!-- Tonearm -->
                        <Path x:Name="Tonearm" Data="M 100,100 L 190,20" Stroke="#9C8968" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              RenderTransformOrigin="1.0,0.1">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="TonearmRotation" Angle="-32"/>
                            </Path.RenderTransform>
                        </Path>
                        <Ellipse Width="16" Height="16" Fill="{StaticResource GoldBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="92,92,0,0"/>
                    </Grid>

                    <TextBlock x:Name="StatusLine" Text="Ready when you are" HorizontalAlignment="Center" FontFamily="Consolas" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,18"/>

                    <Button x:Name="PlayBtn" Content="▶ Drop the needle" Style="{StaticResource GoldButton}" Click="PlayNeedle_Click"/>

                    <!-- Multiple choice -->
                    <StackPanel x:Name="ChoicesPanel" Visibility="Collapsed" Margin="0,18,0,0">
                        <Button Content="Sample Track A — Artist One" Style="{StaticResource ChoiceButton}" Click="Choice_Click"/>
                        <Button Content="Sample Track B — Artist Two" Style="{StaticResource ChoiceButton}" Click="Choice_Click"/>
                        <Button Content="Sample Track C — Artist Three" Style="{StaticResource ChoiceButton}" Click="Choice_Click"/>
                        <Button Content="Sample Track D — Artist Four" Style="{StaticResource ChoiceButton}" Click="Choice_Click"/>
                    </StackPanel>

                    <!-- Type-in guess -->
                    <StackPanel x:Name="GuessPanel" Visibility="Collapsed" Margin="0,18,0,0">
                        <TextBox x:Name="GuessInput" Style="{StaticResource TextInput}" FontFamily="Consolas" Tag="Start typing…"/>
                        <Button Content="Lock it in" Style="{StaticResource GoldButton}" Click="LockGuess_Click"/>
                    </StackPanel>

                    <!-- Reveal -->
                    <Border x:Name="RevealPanel" Visibility="Collapsed" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,18,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="56" Height="56" Background="{StaticResource GoldDimBrush}" CornerRadius="6" Margin="0,0,14,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Sample Track A" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="Artist One" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button x:Name="NextTrackBtn" Content="Next track →" Style="{StaticResource SecondaryButton}" Visibility="Collapsed" Margin="0,14,0,0" Click="NextTrack_Click"/>
                </StackPanel>

                <!-- ============ SCREEN 4: FINAL (song mode) ============ -->
                <StackPanel x:Name="ScreenFinal" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" Margin="0,20,0,20">
                        <TextBlock x:Name="FinalScoreText" Text="0/10" FontFamily="Georgia" FontWeight="Black" FontSize="56" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="FINAL SCORE" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <TextBlock Text="THE ONES THAT GOT AWAY" Style="{StaticResource SectionLabel}"/>
                    <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Sample Track E — Artist Five" Foreground="{StaticResource TextBrush}" FontSize="13" Margin="0,0,0,6"/>
                            <TextBlock Text="Sample Track F — Artist Six" Foreground="{StaticResource TextBrush}" FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="SAVE YOUR SCORE" Style="{StaticResource SectionLabel}"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SongInitialsInput" Grid.Column="0" Style="{StaticResource TextInput}" MaxLength="3" CharacterCasing="Upper" Margin="0" Tag="JWB"/>
                        <Button x:Name="SongSubmitScoreBtn" Grid.Column="2" Content="Submit" Style="{StaticResource GoldButton}" Padding="16,10" Margin="0" Click="SubmitSongScore_Click"/>
                    </Grid>

                    <TextBlock Text="LEADERBOARD — GUESS THE SONG" Style="{StaticResource SectionLabel}"/>
                    <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,18">
                        <StackPanel x:Name="SongLeaderboardList"/>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Run it back" Style="{StaticResource SecondaryButton}" Click="Restart_Click"/>
                        <Button Grid.Column="2" Content="All games" Style="{StaticResource SecondaryButton}" Click="BackToModeSelect_Click"/>
                    </Grid>
                </StackPanel>

                <!-- ============ SCREEN 5: STREAMS SOURCE ============ -->
                <StackPanel x:Name="ScreenStreamsSource" Visibility="Collapsed">
                    <TextBlock Text="MODE: STREAMS SHOWDOWN" Style="{StaticResource EyebrowText}"/>
                    <TextBlock Text="Where from?" FontFamily="Georgia" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                    <TextBlock Style="{StaticResource WizardCopy}" Text="Battle songs pulled from one of your playlists, or skip Spotify entirely and draw from a year's Billboard Hot 100."/>

                    <UniformGrid Columns="2" Margin="0,0,0,14">
                        <ToggleButton x:Name="StreamsOptPlaylist" Content="From a Playlist" Style="{StaticResource RadioChip}" IsChecked="True" Margin="0,0,4,0" Click="StreamsSourceOption_Click"/>
                        <ToggleButton x:Name="StreamsOptBillboard" Content="Billboard Year" Style="{StaticResource RadioChip}" Margin="4,0,0,0" Click="StreamsSourceOption_Click"/>
                    </UniformGrid>

                    <StackPanel x:Name="StreamsPlaylistInputWrap">
                        <TextBlock Text="PLAYLIST URL OR ID" Style="{StaticResource SectionLabel}"/>
                        <TextBox x:Name="StreamsPlaylistUrlInput" Style="{StaticResource TextInput}" Tag="https://open.spotify.com/playlist/..."/>
                    </StackPanel>

                    <StackPanel x:Name="StreamsBillboardInputWrap" Visibility="Collapsed">
                        <TextBlock Text="CHART YEAR" Style="{StaticResource SectionLabel}"/>
                        <ComboBox x:Name="BillboardYearCombo" Style="{StaticResource ComboInput}" SelectedIndex="10">
                            <ComboBoxItem Content="2026"/>
                            <ComboBoxItem Content="2025"/>
                            <ComboBoxItem Content="2024"/>
                            <ComboBoxItem Content="2023"/>
                            <ComboBoxItem Content="2022"/>
                            <ComboBoxItem Content="2021"/>
                            <ComboBoxItem Content="2020"/>
                            <ComboBoxItem Content="2019"/>
                            <ComboBoxItem Content="2018"/>
                            <ComboBoxItem Content="2017"/>
                            <ComboBoxItem Content="2016"/>
                            <ComboBoxItem Content="2015"/>
                        </ComboBox>
                    </StackPanel>

                    <Button Content="Start the showdown" Style="{StaticResource GoldButton}" Margin="0,8,0,0" Click="StartShowdown_Click"/>
                    <Button Content="← All games" Style="{StaticResource LinkButton}" Click="BackToModeSelect_Click"/>
                </StackPanel>

                <!-- ============ SCREEN 6: STREAMS GAME ============ -->
                <StackPanel x:Name="ScreenStreamsGame" Visibility="Collapsed">
                    <TextBlock x:Name="StreamsSourceBadge" Text="BILLBOARD 2025" HorizontalAlignment="Center" Foreground="{StaticResource GoldBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Which one has more streams?" FontFamily="Consolas" Foreground="{StaticResource MutedBrush}" FontSize="13" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="STREAK " FontFamily="Consolas" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StreakText" Text="0" FontFamily="Consolas" Foreground="{StaticResource GoldBrush}" FontWeight="Bold" FontSize="18"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,4,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="StreamsCardA" Grid.Column="0" Style="{StaticResource BattleCard}" Click="StreamsCard_Click">
                            <StackPanel>
                                <Border Height="90" Background="{StaticResource GoldDimBrush}" CornerRadius="6" Margin="0,0,0,10"/>
                                <TextBlock x:Name="CardATitle" Text="Sample Track A" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="CardAArtist" Text="Artist One" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,8"/>
                                <TextBlock x:Name="CardAStreams" Text="" FontFamily="Consolas" FontWeight="Bold" FontSize="14" Foreground="{StaticResource GoldBrush}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Grid.Column="1" Text="VS" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Georgia" FontWeight="Bold" FontSize="14" Foreground="{StaticResource MutedBrush}"/>

                        <Button x:Name="StreamsCardB" Grid.Column="2" Style="{StaticResource BattleCard}" Click="StreamsCard_Click">
                            <StackPanel>
                                <Border Height="90" Background="{StaticResource GoldDimBrush}" CornerRadius="6" Margin="0,0,0,10"/>
                                <TextBlock x:Name="CardBTitle" Text="Sample Track B" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="CardBArtist" Text="Artist Two" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,8"/>
                                <TextBlock x:Name="CardBStreams" Text="" FontFamily="Consolas" FontWeight="Bold" FontSize="14" Foreground="{StaticResource GoldBrush}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock x:Name="StreamsStatusLine" Text="Tap a card to lock your pick" HorizontalAlignment="Center" FontFamily="Consolas" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,14"/>

                    <Button x:Name="NextMatchupBtn" Content="Next matchup →" Style="{StaticResource SecondaryButton}" Visibility="Collapsed" Click="NextMatchup_Click"/>
                </StackPanel>

                <!-- ============ SCREEN 7: STREAMS FINAL ============ -->
                <StackPanel x:Name="ScreenStreamsFinal" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" Margin="0,20,0,20">
                        <TextBlock x:Name="FinalStreakText" Text="0" FontFamily="Georgia" FontWeight="Black" FontSize="56" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="YOUR STREAK" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <TextBlock Text="SAVE YOUR SCORE" Style="{StaticResource SectionLabel}"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="StreamsInitialsInput" Grid.Column="0" Style="{StaticResource TextInput}" MaxLength="3" CharacterCasing="Upper" Margin="0" Tag="JWB"/>
                        <Button x:Name="StreamsSubmitScoreBtn" Grid.Column="2" Content="Submit" Style="{StaticResource GoldButton}" Padding="16,10" Margin="0" Click="SubmitStreamsScore_Click"/>
                    </Grid>

                    <TextBlock Text="LEADERBOARD — STREAMS SHOWDOWN" Style="{StaticResource SectionLabel}"/>
                    <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,18">
                        <StackPanel x:Name="StreamsLeaderboardList"/>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Play again" Style="{StaticResource SecondaryButton}" Click="PlayStreamsAgain_Click"/>
                        <Button Grid.Column="2" Content="All games" Style="{StaticResource SecondaryButton}" Click="BackToModeSelect_Click"/>
                    </Grid>
                </StackPanel>

            </Grid>
        </Border>

    </Grid>
    </ScrollViewer>
</Window>
